# Copia este archivo como .env y ajusta los valores segun tu entorno.

# Llave secreta de Django. En produccion usa una cadena larga y aleatoria.
SECRET_KEY=cambia-esta-llave-en-produccion

# Modo depuracion. Usa False en produccion.
DEBUG=True

# Dominios permitidos separados por comas.
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos. Deja sqlite para desarrollo o cambia a mysql cuando lo tengas.
DB_ENGINE=sqlite

# Datos de conexion para MySQL (solo si DB_ENGINE=mysql).
DB_NAME=edumetrica
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
