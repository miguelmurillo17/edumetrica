# Copia este archivo como .env y ajusta los valores segun tu entorno.

# Llave secreta de Django. En produccion usa una cadena larga y aleatoria.
SECRET_KEY=cambia-esta-llave-en-produccion

# Modo depuracion. Usa False en produccion.
DEBUG=True

# Dominios permitidos separados por comas.
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos. Deja sqlite para desarrollo o cambia a mysql cuando lo tengas.
DB_ENGINE=sqlite

# Datos de conexion para MySQL (solo si DB_ENGINE=mysql).
DB_NAME=edumetrica
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Envio de correo para restablecer la contrasena.
# Deja "consola" en desarrollo: el mensaje se imprime en la terminal.
# Usa "smtp" en produccion y llena los datos de abajo.
EMAIL_BACKEND=consola
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-responder@edumetrica.mx

# Dirección pública del sitio. Los correos llevan enlaces absolutos, así que
# en producción esto debe apuntar al dominio real y no a 127.0.0.1.
SITIO_URL=http://127.0.0.1:8000

# Los correos salen en un hilo para no dejar esperando al profesor. Ponlo en
# False si prefieres verlos en orden en la consola mientras desarrollas.
CORREO_EN_HILO=True

# --- Generación de preguntas con IA -------------------------------------
# Proveedor activo. Uno de: gemini | groq | deepseek
AI_PROVIDER=gemini

# Opcional: sobrescribe el modelo por omisión del proveedor.
# Debe incluir el prefijo de LiteLLM, por ejemplo gemini/gemini-2.5-flash
AI_MODEL=

# Parámetros de generación
AI_TEMPERATURE=0.7
# Medido: una pregunta con su procedimiento cuesta ~1000 tokens de salida.
# Como se genera de una en una, 4096 deja margen de sobra.
AI_MAX_TOKENS=4096
AI_TIMEOUT=30
# Medido: un intento fallido tarda ~21s. Con 2 reintentos una
# saturación del proveedor bloqueaba la pantalla 2 minutos.
AI_MAX_RETRIES=1

# Cuántas generaciones puede pedir un profesor por hora. La cuota es del
# proveedor y la comparte toda la institución: sin este tope, un profesor la
# agota para los demás. Cuentan todas las solicitudes, salgan bien o mal.
AI_LIMITE_POR_HORA=20

# Llaves. Define solo la del proveedor que vayas a usar.
# Gemini:   https://aistudio.google.com/app/apikey
# Groq:     https://console.groq.com/keys
# DeepSeek: https://platform.deepseek.com
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
