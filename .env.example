# Copia este archivo como .env y ajusta los valores segun tu entorno.

# Llave secreta de Django. En produccion usa una cadena larga y aleatoria.
SECRET_KEY=cambia-esta-llave-en-produccion

# Modo depuracion. Usa False en produccion.
DEBUG=True

# Dominios permitidos separados por comas.
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos. Deja sqlite para desarrollo o cambia a mysql cuando lo tengas.
DB_ENGINE=sqlite

# Datos de conexion para MySQL (solo si DB_ENGINE=mysql).
DB_NAME=edumetrica
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Envio de correo para restablecer la contrasena.
# Deja "consola" en desarrollo: el mensaje se imprime en la terminal.
# Usa "smtp" en produccion y llena los datos de abajo.
EMAIL_BACKEND=consola
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-responder@edumetrica.mx
